---
// The meetup intro deck: a whole reveal.js document for one event, built from events.yaml, speakers.yaml and the
// Stripe supporters. A slide whose data is missing is left out. Wording on the fixed slides is the site's own.
import '@fontsource/anton';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import { lineupEntries, fmtDay, fmtTime, type Event } from '../../lib/data';
import { stats } from '../../data/site';

interface Props {
  event: Event;
  next?: Event;
  supporters: string[];
}
const { event, next, supporters } = Astro.props;
const e = event.data;
const speakers = new Map((await getCollection('speakers')).map((s) => [s.id, s.data]));
const talks = lineupEntries(event).map((x) => ({ ...x, who: speakers.get(x.speaker) }));
const tba = (v: { name: string }) => /to be announced/i.test(v.name);
const talksAt = e.agenda.find((a) => /talk/i.test(a.label))?.time;
const place = (v: { name: string; address?: string }) => (v.address ? `${v.name}, ${v.address}` : v.name);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{`${e.title}, ${fmtDay(e.start)} | AIMUG intro`}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body data-pagefind-ignore="all">
    <div class="reveal">
      <div class="slides">
        <section>
          <p class="kicker">AIMUG · AI Middleware Users Group</p>
          <h1>{e.title}</h1>
          <p class="big">{fmtDay(e.start, { weekday: 'long', month: 'long' })} · {e.venue.name}</p>
          {talksAt && <p class="big gold">Talks start at {talksAt}</p>}
          <p class="url">aimug.org</p>
        </section>

        {e.agenda.length > 0 && (
          <section>
            <h2>Tonight</h2>
            <ul class="agenda">
              {e.agenda.map((a) => <li><span class="gold">{a.time}</span><span>{a.label}</span></li>)}
            </ul>
          </section>
        )}

        <section>
          <h2>Who we are</h2>
          <p class="big">The AI Middleware Users Group. Free talks on the agentic stack in Austin and online.</p>
          <div class="stats">
            <p><span class="gold">{stats.meetupMembers.toLocaleString('en-US')}</span> members on Meetup</p>
            <p><span class="gold">{stats.youtubeViews.toLocaleString('en-US')}</span> views on YouTube</p>
          </div>
        </section>

        <section>
          <h2>Be cool to each other</h2>
          <h2 class="gold">Don't be gross</h2>
          <p class="url">aimug.org/code-of-conduct</p>
        </section>

        <section>
          <h2>Where and when we meet</h2>
          <div class="cards">
            <div><h3>The meetup</h3><p>First Monday of every month, 6 PM at ACC Rio Grande in Austin, or online.</p></div>
            <div><h3>Office Hours</h3><p>2nd, 3rd and 4th Mondays, 5 PM CT, on Google Meet.</p></div>
            <div><h3>Hacky Hours</h3><p>Casual meetups to work on projects together and talk shop, announced on Meetup and Discord.</p></div>
          </div>
        </section>

        {talks.length > 0 && (
          <section>
            <h2>Tonight's talks</h2>
            <ol class="talks">
              {talks.map((t) => (
                <li>
                  {t.who?.photo ? <img src={t.who.photo} alt="" /> : <span class="nophoto" />}
                  <div><p class="who">{t.who?.name ?? t.speaker}</p>{t.title && <p class="title">{t.title}</p>}</div>
                </li>
              ))}
            </ol>
            <aside class="notes">
              {talks.map((t) => <p>{t.who?.name ?? t.speaker}{t.intro ? `: ${t.intro}` : ''}</p>)}
            </aside>
          </section>
        )}

        <section>
          <h2>Thank you</h2>
          {supporters.length > 0 && (
            <>
              <p class="lead">Our monthly supporters keep AIMUG free and independent</p>
              <ul class="supporters">{supporters.map((n) => <li>{n}</li>)}</ul>
            </>
          )}
          {e.sponsor && (
            <p class="lead">Tonight's food and drinks: {e.sponsor.logo ? <img class="logo" src={e.sponsor.logo} alt={e.sponsor.name} /> : e.sponsor.name}</p>
          )}
          <p class="partners">Center for Government and Civic Service, Austin Community College · LangChain</p>
        </section>

        {next && (
          <section>
            <p class="kicker">Next meetup</p>
            <h2>{next.data.title}</h2>
            <p class="big">{fmtDay(next.data.start, { weekday: 'long', month: 'long' })}, {fmtTime(next.data.start)}</p>
            <p class="big">{next.data.venue.name}</p>
            <p class="url">aimug.org/events</p>
          </section>
        )}

        {(e.afterparty || !tba(e.venue)) && (
          <section>
            {e.afterparty && (<><h2>After party</h2><p class="big gold">{place(e.afterparty)}</p></>)}
            {!tba(e.venue) && (
              <>
                <h3>Finding us</h3>
                <p>{place(e.venue)}. The parking garage is free, but its doors lock at 9 PM. Street parking is free after 6 PM.</p>
              </>
            )}
          </section>
        )}
      </div>
    </div>

    <script>
      import Reveal from 'reveal.js';
      import Notes from 'reveal.js/plugin/notes';
      import 'reveal.js/reset.css';
      import 'reveal.js/reveal.css';
      Reveal.initialize({ hash: true, width: 1280, height: 720, margin: 0.04, plugins: [Notes] });
    </script>

    <style is:global>
      html, body, .reveal-viewport { --r-background-color: var(--color-ink); background: var(--color-ink); }
      .reveal { font-family: var(--font-sans); font-size: 34px; color: var(--color-text); }
      .reveal .slides { text-align: left; }
      .reveal .slides section > * + * { margin-top: 22px; }
      .reveal h1, .reveal h2, .reveal h3 { font-family: var(--font-display); font-weight: 400; text-transform: uppercase; letter-spacing: 0.02em; line-height: 1.02; margin: 0; color: var(--color-text); }
      .reveal h1 { font-size: 104px; }
      .reveal h2 { font-size: 72px; }
      .reveal h3 { font-size: 34px; color: var(--color-gold); }
      .reveal p { margin: 0; line-height: 1.3; }
      .reveal .gold { color: var(--color-gold); }
      .reveal .kicker { font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-gold); font-size: 26px; }
      .reveal .big { font-size: 40px; color: var(--color-soft); }
      .reveal .lead { font-size: 30px; color: var(--color-soft); }
      .reveal .url { font-family: var(--font-mono); font-size: 26px; color: var(--color-muted); }
      .reveal .agenda { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
      .reveal .agenda li { display: grid; grid-template-columns: 170px 1fr; font-size: 36px; }
      .reveal .stats { display: flex; gap: 60px; font-size: 32px; }
      .reveal .stats .gold { font-family: var(--font-display); font-size: 72px; display: block; }
      .reveal .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
      .reveal .cards > div { background: var(--color-panel); border: 1px solid var(--color-line); border-radius: 18px; padding: 24px; display: grid; gap: 12px; align-content: start; font-size: 28px; }
      .reveal .talks { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
      .reveal .talks li { display: grid; grid-template-columns: 64px 1fr; gap: 18px; align-items: center; }
      .reveal .talks img, .reveal .talks .nophoto { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; border: 2px solid var(--color-gold); }
      .reveal .talks .nophoto { background: var(--color-panel); }
      .reveal .talks .who { font-weight: 700; font-size: 24px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-gold); }
      .reveal .talks .title { font-size: 29px; line-height: 1.15; }
      .reveal .supporters { list-style: none; margin: 0; padding: 0; columns: 4; column-gap: 32px; font-size: 30px; }
      .reveal .supporters li { break-inside: avoid; padding: 3px 0; }
      .reveal .logo { height: 64px; vertical-align: middle; }
      .reveal .partners { font-size: 24px; color: var(--color-muted); }
      .reveal .controls { color: var(--color-gold); }
      .reveal .progress { color: var(--color-gold); }
    </style>
  </body>
</html>
