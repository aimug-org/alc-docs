---
import { venueThanks, channels } from '../data/site';
import Icon from './Icon.astro';
const cols = [
  { h: 'Attend', items: [['Events', '/events/'], ['Office Hours', '/events/#office-hours'], ['Community', '/community/'], ['Code of conduct', '/code-of-conduct/']] },
  { h: 'Watch', items: [['Talks', '/talks/'], ['Speakers', '/speakers/'], ['Recaps', '/blog/'], ['Notes', '/docs/']] },
  { h: 'Take part', items: [['Speak', '/speak/'], ['Support', '/support/'], ['Volunteer', '/volunteer/']] },
];
---
<footer class="border-t border-line bg-deep">
  <div class="mx-auto grid max-w-[1240px] grid-cols-[repeat(auto-fit,minmax(min(100%,200px),1fr))] gap-8 px-4 pt-12 pb-8 sm:px-8">
    <div class="flex flex-col gap-3">
      <img src="/logo.png" alt="AIMUG parrot logo" width="64" height="64" class="h-16 w-16 rounded-xl" />
      <p class="m-0 text-[15px] text-muted">AIMUG, the AI Middleware Users Group. Austin, Texas. {venueThanks}</p>
    </div>
    {cols.map((c) => (
      <nav aria-label={c.h} class="flex flex-col text-base">
        <span class="font-mono text-sm tracking-[0.1em] text-muted uppercase">{c.h}</span>
        {c.items.map(([label, href]) => <a href={href} class="inline-flex min-h-[44px] items-center text-text no-underline hover:text-gold">{label}</a>)}
      </nav>
    ))}
    <nav aria-label="Follow" class="flex flex-col text-base">
      <span class="font-mono text-sm tracking-[0.1em] text-muted uppercase">Follow</span>
      {channels.map((c) => <a href={c.href} class="inline-flex min-h-[44px] items-center gap-2.5 text-text no-underline hover:text-gold"><Icon name={c.key} size={18} class="text-muted" />{c.label}</a>)}
    </nav>
  </div>
  <div class="mx-auto max-w-[1240px] px-4 pb-8 text-sm text-muted sm:px-8">Content CC BY 4.0. <a href="https://github.com/aimug-org/alc-docs" class="inline-flex min-h-[44px] items-center">Edit this site on GitHub</a>.</div>
</footer>
