---
import Base from '../../layouts/Base.astro';
import { postDay, posts } from '../../components/content/content';

const all = await posts();
const years = [...new Set(all.map((p) => p.date.getUTCFullYear()))];
---
<Base title="Recap archive" description="Every AIMUG recap, by year.">
  <div class="mx-auto max-w-[1240px] px-4 pt-12 pb-20 sm:px-8 sm:pt-16">
    <p class="m-0 mb-2 font-mono text-sm tracking-[0.12em] text-gold uppercase"><a href="/blog/" class="text-gold no-underline">Recaps</a></p>
    <h1 class="m-0 font-display text-[clamp(44px,6vw,80px)] leading-none font-normal uppercase">Archive</h1>
    {years.map((y) => (
      <section class="mt-10">
        <h2 class="m-0 font-display text-4xl font-normal text-gold">{y}</h2>
        <ul class="m-0 mt-3 list-none p-0">
          {all.filter((p) => p.date.getUTCFullYear() === y).map((p) => (
            <li class="grid gap-x-6 border-t border-line py-3 sm:grid-cols-[130px_1fr]">
              <time datetime={p.date.toISOString().slice(0, 10)} class="font-mono text-sm text-muted uppercase">{postDay(p.date)}</time>
              <a href={p.url} class="font-semibold text-text no-underline hover:text-gold">{p.entry.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
