---
import Base from '../../../layouts/Base.astro';
import { authors, posts } from '../../../components/content/content';

const all = await posts();
const list = [...(await authors()).values()]
  .map((a) => ({ ...a, n: all.filter((p) => p.entry.data.authors.includes(a.id)).length }))
  .sort((a, b) => b.n - a.n || a.name.localeCompare(b.name));
---
<Base title="Recap authors" description="The people who write the AIMUG recaps.">
  <div class="mx-auto max-w-[1240px] px-4 pt-12 pb-20 sm:px-8 sm:pt-16">
    <p class="m-0 mb-2 font-mono text-sm tracking-[0.12em] text-gold uppercase"><a href="/blog/" class="text-gold no-underline">News</a></p>
    <h1 class="m-0 font-display text-[clamp(44px,6vw,80px)] leading-none font-normal uppercase">Authors</h1>
    <ul class="m-0 mt-10 grid list-none grid-cols-[repeat(auto-fill,minmax(min(100%,280px),1fr))] gap-4 p-0">
      {list.map((a) => (
        <li>
          <a href={a.href} class="flex h-full items-center gap-4 rounded-[18px] border border-line bg-panel p-5 text-text no-underline hover:border-gold">
            {a.image_url && <img src={a.image_url} alt="" width="56" height="56" loading="lazy" class="h-14 w-14 shrink-0 rounded-full border border-edge object-cover" />}
            <span class="flex flex-col leading-tight">
              <span class="font-bold">{a.name}</span>
              {a.title && <span class="mt-1 text-sm text-muted">{a.title}</span>}
              <span class="mt-2 font-mono text-xs text-soft uppercase">{a.n} {a.n === 1 ? 'post' : 'posts'}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
