---
import Base from '../../layouts/Base.astro';
import { allEvents, fmtDay, now } from '../../lib/data';

const dl = (await allEvents()).find((e) => e.data.start > now && !e.data.lineup.length && e.data.pitchDeadline && e.data.pitchDeadline > now)?.data.pitchDeadline;
const pickLine = dl ? `Pitches close ${fmtDay(dl, { weekday: 'long' })}. We pick the lineup that week and email you.` : 'We pick the lineup the week before the meetup and email you.';
---
<Base title="Pitch received" description="Thanks for pitching a talk to AIMUG." noindex>
  <section aria-labelledby="thanks-h" class="mx-auto max-w-[1240px] px-4 py-16 sm:px-8 sm:py-24">
    <div class="flex max-w-[760px] flex-col gap-4 rounded-[22px] border border-gold bg-panel p-6 sm:p-10">
      <p class="m-0 font-mono text-sm tracking-[0.12em] text-gold">PITCH RECEIVED</p>
      <h1 id="thanks-h" class="m-0 font-display text-[clamp(48px,7vw,88px)] leading-[0.95] font-normal uppercase">Thanks, it's in</h1>
      <p class="m-0 text-xl text-soft">We emailed you a copy of your pitch and the release you signed. We read every pitch. {pickLine}</p>
      <p class="m-0 text-soft">To take a recording down later, reply to that email or write to <a href="mailto:speakers@aimug.org">speakers@aimug.org</a>.</p>
      <div class="mt-2 flex flex-wrap gap-3.5">
        <a href="/talks/" class="rounded-full bg-gold px-7 py-4 text-lg font-bold text-ink no-underline hover:bg-gold-hi hover:text-ink">Watch past talks</a>
        <a href="/" class="rounded-full border-2 border-text px-6 py-3.5 text-lg font-bold text-text no-underline hover:border-gold hover:text-gold">Back home</a>
      </div>
    </div>
  </section>
</Base>
