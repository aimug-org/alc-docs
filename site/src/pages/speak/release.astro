---
// /speak/release/: the speaker release on its own, for talks we already recorded. Link a speaker straight to
// their talk with /speak/release/?talk=<slug>. Posts to /api/speak as kind "release".
import { getEntries } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ReleaseFields from '../../components/speak/ReleaseFields.astro';
import { fmtDate } from '../../lib/data';
import { ui, releaseTalks, talkEvent } from '../../lib/speak';

const talks = await releaseTalks();
const ids = [...new Set(talks.flatMap((t) => t.data.speakers))];
const names = new Map((await getEntries(ids.map((id) => ({ collection: 'speakers' as const, id })))).filter((s) => !!s).map((s) => [s!.id, s!.data.name]));
// Grouped by meetup date, newest first (releaseTalks is already sorted).
const groups = Map.groupBy(talks, talkEvent);
const { panel, field, label, input, legend, gold } = ui;
---
<Base title="Sign your speaker release" description="For AIMUG speakers whose talk is already recorded: sign the release that lets us publish it." noindex>
  <section aria-labelledby="release-h" class="mx-auto max-w-[1240px] px-4 pt-12 pb-16 sm:px-8 sm:pt-16">
    <div class="flex max-w-[820px] flex-col">
      <p class="m-0 mb-2 font-mono text-sm tracking-[0.12em] text-gold">FOR AIMUG SPEAKERS</p>
      <h1 id="release-h" class="m-0 font-display text-[clamp(48px,7vw,88px)] leading-[0.95] font-normal uppercase">Sign your speaker release</h1>
      <p class="m-0 mt-4 text-xl text-soft">Your talk is already recorded. This release lets us publish it on YouTube, social media, aimug.org and public-access TV. It takes a minute.</p>

      <form id="release-form" data-speak action="/api/speak" method="post" class="mt-10 flex flex-col gap-10">
        <input type="hidden" name="kind" value="release" />
        <fieldset data-step="0" class="m-0 min-w-0 p-0">
          <legend class={legend}><span class="block font-display text-4xl uppercase">Your talk</span></legend>
          <div class={panel}>
            <div class={field}>
              <label for="sp-talk" class={label}>Talk</label>
              <select id="sp-talk" name="talk" required class={`${input} min-h-[52px] cursor-pointer`}>
                <option value="">Choose your talk</option>
                {[...groups].map(([event, list]) => (
                  <optgroup label={fmtDate(new Date(event), { year: 'numeric' })}>
                    {list.map((t) => <option value={t.id}>{t.data.title} · {t.data.speakers.map((id) => names.get(id) ?? id).join(', ')}</option>)}
                  </optgroup>
                ))}
              </select>
              {!talks.length && <p class="m-0 text-[15px] text-muted">No recorded talks are listed yet. Write to <a href="mailto:speakers@aimug.org">speakers@aimug.org</a> and we'll send you a link.</p>}
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              <div class={field}>
                <label for="sp-name" class={label}>Name</label>
                <input id="sp-name" name="name" type="text" required maxlength="120" autocomplete="name" class={input} />
              </div>
              <div class={field}>
                <label for="sp-email" class={label}>Email</label>
                <input id="sp-email" name="email" type="email" required maxlength="254" autocomplete="email" class={input} />
              </div>
            </div>
            <ReleaseFields />
          </div>
        </fieldset>

        <div class="flex flex-col gap-4">
          <p id="speak-status" role="status" aria-live="polite" class="m-0 text-[17px] font-semibold text-gold-hi empty:hidden"></p>
          <div class="flex flex-wrap gap-3">
            <button type="submit" data-send class={gold}>Sign the release</button>
          </div>
        </div>
      </form>

      <div id="speak-done" hidden tabindex="-1" class="mt-10 flex flex-col gap-3 rounded-[22px] border border-gold bg-panel p-6 sm:p-9">
        <p class="m-0 font-mono text-sm tracking-[0.12em] text-gold">RELEASE SIGNED</p>
        <h2 class="m-0 font-display text-[clamp(40px,5vw,60px)] leading-none font-normal uppercase">Thank you</h2>
        <p class="m-0 text-soft">A copy of the release is on its way to <strong class="break-all text-text" data-email></strong>. Nothing else to do.</p>
        <p class="m-0 font-mono text-sm text-muted">Record <span data-id></span></p>
      </div>
    </div>
  </section>

  <script>
    import '../../components/speak/speak-form.js';
  </script>
</Base>
