---
import { getCollection } from 'astro:content';
import DocsPage from '../../components/content/DocsPage.astro';
import { docTitle, docUrl, docsNav, nightUrl, noteGroups } from '../../components/content/content';
import { fmtDay } from '../../lib/data';

// Built from the month folders, so a new meetup's labs show up here without editing this page.
// Talk write-ups live on their talk pages and each night's overview on its night page, so Notes is labs, slides and guides.
const groups = await noteGroups();
const years = [...new Set(groups.map((g) => g.year))];
const { docs } = await docsNav();
const guides = docs.filter((d) => !d.id.includes('/') || d.id === 'langchain-104/introduction-to-104');
const talksWithWriteups = (await getCollection('talks')).filter((t) => t.data.writeup).length;
const link = 'inline-flex min-h-[44px] items-center font-semibold no-underline';
---
<DocsPage title="Notes" description="Labs, slides and guides from AIMUG meetups since 2023, newest first." current="/docs/">
  <div class="flex flex-col gap-12">
    <header class="flex flex-col gap-3">
      <h1 class="m-0 font-display text-[clamp(52px,7vw,88px)] leading-[0.95] font-normal uppercase">Notes</h1>
      <p class="m-0 max-w-[680px] text-xl text-soft">Labs, slides and guides from AIMUG meetups. Write-ups of {talksWithWriteups} talks now sit with their video on the <a href="/talks/">talk pages</a>, and each night's story is on its <a href="/events/">event page</a>.</p>
    </header>

    <section aria-labelledby="g-h" class="flex flex-col gap-3 rounded-[22px] border-2 border-gold bg-panel p-6 sm:p-8">
      <h2 id="g-h" class="m-0 font-mono text-sm tracking-[0.12em] text-gold uppercase">Start here</h2>
      <ul class="m-0 flex list-none flex-wrap gap-x-8 p-0">
        {guides.map((d) => <li><a href={docUrl(d.id)} class={link}>{docTitle(d)}</a></li>)}
      </ul>
    </section>

    {years.map((y) => (
      <section aria-labelledby={`y-${y}`} class="flex flex-col gap-4">
        <h2 id={`y-${y}`} class="m-0 font-display text-[clamp(36px,4vw,48px)] leading-none font-normal uppercase">{y}</h2>
        <ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(min(100%,300px),1fr))] gap-4 p-0">
          {groups.filter((g) => g.year === y).map((g) => (
            <li class="flex flex-col gap-2 rounded-[18px] border border-line bg-panel p-5">
              <p class="m-0 font-mono text-sm tracking-[0.12em] text-muted uppercase">{g.label}</p>
              <ul class="m-0 flex list-none flex-col p-0">
                {g.pages.slice(0, 6).map((d) => <li><a href={docUrl(d.id)} class="inline-flex min-h-[40px] items-center leading-snug text-text no-underline hover:text-gold">{docTitle(d)}</a></li>)}
              </ul>
              {g.pages.length > 6 && <p class="m-0 text-[15px] text-muted">and {g.pages.length - 6} more in the menu</p>}
              {g.night && <a href={nightUrl(g.night.id)} class={link}>The {fmtDay(g.night.data.start, { weekday: undefined })} night →</a>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</DocsPage>
