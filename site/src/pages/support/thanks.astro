---
import Base from '../../layouts/Base.astro';
---
<Base title="Thanks for sponsoring" description="Thanks for offering to sponsor AIMUG." noindex>
  <section aria-labelledby="thanks-h" class="mx-auto max-w-[1240px] px-4 py-16 sm:px-8 sm:py-24">
    <div class="flex max-w-[760px] flex-col gap-4 rounded-[22px] border border-gold bg-panel p-6 sm:p-10">
      <p class="m-0 font-mono text-sm tracking-[0.12em] text-gold">NOTE RECEIVED</p>
      <h1 id="thanks-h" class="m-0 font-display text-[clamp(48px,7vw,88px)] leading-[0.95] font-normal uppercase">Thanks, it's in</h1>
      <p class="m-0 text-xl text-soft">We emailed you a confirmation, and an organizer will reply by email. To add anything, reply to that email or write to <a href="mailto:sponsors@aimug.org">sponsors@aimug.org</a>.</p>
      <div class="mt-2 flex flex-wrap gap-3.5">
        <a href="/events/" class="rounded-full bg-gold px-7 py-4 text-lg font-bold text-ink no-underline hover:bg-gold-hi hover:text-ink">See upcoming events</a>
        <a href="/support/" class="rounded-full border-2 border-text px-6 py-3.5 text-lg font-bold text-text no-underline hover:border-gold hover:text-gold">Back to Support</a>
      </div>
    </div>
  </section>
</Base>
