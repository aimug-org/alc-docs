    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "pagefind": "1.5.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
